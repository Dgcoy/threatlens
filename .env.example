# ThreatLens .env — copy to .env and fill. NEVER commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Postgres ---
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=threatlens

# --- API / dashboard ---
APP_PIN=CHANGE_ME            # 6-digit PIN for dashboard gate
SESSION_SECRET=CHANGE_ME     # hex secret

# --- Intel engine (optional) ---
# OTX_API_KEY=                # AlienVault OTX (enable feed in UI)
# TAXII_* credentials are per-feed in the UI/DB, not here
